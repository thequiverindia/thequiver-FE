# Payload CMS
PAYLOAD_SECRET=dev-only-secret-change-in-production
# SQLite file for local dev; set to a Neon Postgres URL for staging/prod
DATABASE_URI=file:./thequiver-dev.db

# Auth.js (reader sign-in)
AUTH_SECRET=generate-with: openssl rand -hex 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: protects /api/sync-youtube when set
CRON_SECRET=
