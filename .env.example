# Payload CMS
PAYLOAD_SECRET=dev-only-secret-change-in-production
# SQLite file for local dev; set to a Neon Postgres URL for staging/prod
DATABASE_URI=file:./thequiver-dev.db

# Auth.js (reader sign-in)
AUTH_SECRET=generate-with: openssl rand -hex 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: protects /api/sync-youtube when set
CRON_SECRET=

# Production infrastructure (see SETUP.md)
# NEXT_PUBLIC_SITE_URL=https://your-domain.in
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_ID=

# Pin the OAuth callback host in production (prevents redirect_uri_mismatch
# when the site is reached through a *.vercel.app deployment URL)
AUTH_URL=
